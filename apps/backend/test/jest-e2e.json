{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@photography/types$": "<rootDir>/../../../packages/types/dist/index.js",
    "^@photography/utils$": "<rootDir>/../../../packages/utils/dist/index.js",
    "^@/(.*)$": "<rootDir>/../src/$1"
  }
}
