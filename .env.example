# ============================================================================
# Photography Platform — Environment Variables (copy to .env)
# ============================================================================

# ---- Runtime ----
NODE_ENV=development

# ============================================================================
# BACKEND (apps/backend)
# ============================================================================
BACKEND_PORT=4000
API_GLOBAL_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=photography
DATABASE_PASSWORD=photography
DATABASE_NAME=photography
DATABASE_SSL=false
DATABASE_LOGGING=false
# Set true ONLY in local dev to auto-sync schema; production must use migrations.
DATABASE_SYNCHRONIZE=false

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFICATION_SECRET=change-me-verification-secret-min-32-chars
JWT_VERIFICATION_EXPIRES_IN=1d
JWT_RESET_SECRET=change-me-reset-secret-min-32-chars-long
JWT_RESET_EXPIRES_IN=1h

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ---- Mail (SMTP) ----
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM_NAME=Photography Platform
MAIL_FROM_ADDRESS=no-reply@photography.local

# ---- AWS S3 (image storage) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=photography-platform
AWS_S3_PUBLIC_URL=
# For local dev with MinIO/LocalStack set a custom endpoint, else leave blank.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# ---- Throttling ----
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ---- App URLs (used in emails / OAuth redirects) ----
FRONTEND_URL=http://localhost:3000

# ---- Stripe (marketplace payments; leave blank to disable) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20

# ---- Commerce / digital delivery ----
COMMERCE_CURRENCY=usd
# Tax as basis points: 0 = none, 850 = 8.5%
COMMERCE_TAX_BASIS_POINTS=0
COMMERCE_INVOICE_PREFIX=APT
DOWNLOAD_DEFAULT_LIMIT=5
DOWNLOAD_EXPIRY_DAYS=365
DOWNLOAD_SIGNED_URL_TTL=300
WATERMARK_ENABLED=true
WATERMARK_TEXT=APERTURE — PREVIEW

# ---- Async workers (BullMQ) ----
# Only worker instances should consume jobs; API instances just enqueue.
RUN_WORKERS=false

# ---- Observability (optional — no-ops when unset) ----
APP_NAME=Aperture
# Sentry error reporting
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# OpenTelemetry traces (set to your OTLP collector, e.g. http://localhost:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=aperture-api

# ============================================================================
# FRONTEND (apps/frontend)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Aperture
# Show the "become a photographer" apply flow to regular users (off: only admins upload)
NEXT_PUBLIC_ENABLE_PHOTOGRAPHER_APPLICATIONS=false
# Google Analytics 4 (optional — first-party capture works without it)
NEXT_PUBLIC_GA_ID=
